# Copy to .env (gitignored) and fill in. Never commit real values.

# Lago API key (read-only use; the job only sends GET requests)
LAGO_API_KEY=

# Intuit app credentials. Use a separate Intuit app from the n8n workflow:
# two systems refreshing tokens for the same app and company invalidate each other.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Token store. Only "file" exists today.
TOKEN_STORE=file
# Absolute path, outside the repo. The file must be mode 0600.
TOKEN_STORE_PATH=

# Optional: path to the mapping file (default: ./mappings.yaml)
MAPPINGS_PATH=

# Seeding the Lago TEST org only (npm run seed): the lago_id of the one organization the seed may
# write to. The script refuses unless the API key belongs to exactly this organization.
LAGO_TEST_ORG_ID=
